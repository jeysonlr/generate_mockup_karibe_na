generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Product {
  id               String              @id @default(uuid())
  name             String
  description      String?
  category         String
  price            Decimal?            @db.Decimal(10, 2)
  isActive         Boolean             @default(true)
  isMockupEnabled  Boolean             @default(false) @map("is_mockup_enabled")
  baseImageUrl     String?             @map("base_image_url")
  baseImageData    String?             @map("base_image_data") @db.Text
  backImageUrl     String?             @map("back_image_url")
  backImageData    String?             @map("back_image_data") @db.Text
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  hasSides         Boolean             @default(false) @map("has_sides")
  mockups          MockupGenerated[]
  mockupAreas      ProductMockupArea[]
  variants         ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id             String            @id @default(uuid())
  productId      String            @map("product_id")
  name           String
  attributesJson Json              @map("attributes_json")
  isActive       Boolean           @default(true)
  mockups        MockupGenerated[]
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductMockupArea {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  x         Int
  y         Int
  width     Int
  height    Int
  side      String  @default("front")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_mockup_areas")
}

model MockupGenerated {
  id          String          @id @default(uuid())
  productId   String          @map("product_id")
  variantId   String?         @map("variant_id")
  imageUrl    String          @map("image_url")
  imageData   String?         @map("image_data") @db.Text
  backImageData String?       @map("back_image_data") @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("mockups_generated")
}
