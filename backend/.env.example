# Variáveis do Banco de Dados
DATABASE_URL="postgresql://karibe:karibe123@localhost:5432/karibe_mockup?schema=public"

# Autenticação
JWT_SECRET="troque-por-uma-string-secreta-longa-em-producao"
JWT_EXPIRES_IN="7d"

# Aplicação
NODE_ENV="development"
PORT=3333

# CORS — URL do frontend
FRONTEND_URL="http://localhost:3000"

# Storage
# "local" para filesystem local | "s3" para AWS S3 (futuro)
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# AWS S3 (preencher apenas se STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
